[connection signal="Gameover" from="." to="Player" method="_on_game_manager_gameover"]
[connection signal="Gameover" from="." to="UIManager" method="_on_game_manager_gameover"]
[connection signal="ScoreUpdated" from="." to="." method="_on_score_updated"]
[connection signal="ScoreUpdated" from="." to="UIManager" method="_on_game_manager_score_updated"]
[connection signal="StartGame" from="." to="." method="_on_start_game"]
[connection signal="StartGame" from="." to="Player" method="_on_game_manager_start_game"]
[connection signal="StartGame" from="." to="UIManager" method="_on_game_manager_start_game"]
[connection signal="ScoreUpdated" from="Player" to="." method="_on_player_score_updated"]
[connection signal="area_entered" from="Player/Area3D" to="Player" method="_on_area_3d_area_entered"]
[connection signal="timeout" from="ObstacleSpawnTimer" to="." method="_on_obstacle_spawn_timer_timeout"]
[connection signal="timeout" from="Score" to="." method="_on_score_timeout"]
[connection signal="StartGame" from="UIManager" to="." method="_on_ui_manager_start_game"]
